# Supabase public client variables
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase server-side secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT validation / Supabase auth
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Use SUPABASE_JWT_ISSUER if issuer differs from NEXT_PUBLIC_SUPABASE_URL
SUPABASE_JWT_ISSUER=https://your-project.supabase.co
# Optional audience, defaults to authenticated
SUPABASE_JWT_AUD=authenticated

# Resend email provider key
RESEND_API_KEY=your_resend_api_key

# Optional admin user override
ADMIN_USER_ID=your_admin_user_id
